# ============================================================
# UDYAM AI ENVIRONMENT VARIABLES
# ============================================================

# Existing AI configuration
LLM_PROVIDER=ollama
MODEL_NAME=llama3.2:3b

# Ollama local host
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ============================================================
# SUPABASE BACKEND (FASTAPI SERVER-SIDE)
# ============================================================
# Connect to your Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
# Backend uses SUPABASE_SERVICE_ROLE_KEY or SUPABASE_KEY for administrative/migration operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# ============================================================
# SUPABASE FRONTEND (CLIENT-SIDE VITE)
# Only ANON public keys are safe in browser bundles.
# NEVER place service role key in VITE_* variables.
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_API_BASE_URL=/api

# Stable date for seeded/demo data (YYYY-MM-DD)
UDYAM_DEMO_DATE=2026-09-26

# Comma-separated trusted frontend origins (do not use * with credentials)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional: explicitly enable/disable offline demo authentication (defaults on only when Supabase is unconfigured)
# UDYAM_DEMO_MODE=true
